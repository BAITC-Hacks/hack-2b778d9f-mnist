APP_ENV=development
PUBLIC_HOST=127.0.0.1
PUBLIC_PORT=27361
AGENT_API_KEY=
# Keep the existing GGUF at the repository root.
MODEL_PATH=./Qwen3.5-4B-UD-Q6_K_XL.gguf
LLAMA_SERVER_PATH=llama-server
LLAMA_GPU_LAYERS=99
LLM_HOST=127.0.0.1
LLM_PORT=27362
LLM_BASE_URL=http://127.0.0.1:27362/v1
LLM_MODEL=qwen3.5-4b-local
LLM_CONTEXT_SIZE=8192
LLM_TEMPERATURE=0.1
LLM_MAX_OUTPUT_TOKENS=2048
LLM_TIMEOUT_SECONDS=120
FFMPEG_PATH=ffmpeg
ASR_MODEL=large-v3-turbo
ASR_DEVICE=cpu
ASR_COMPUTE_TYPE=int8
DIARIZATION_MODEL=
DIARIZATION_DEVICE=cpu
# Optional JSON profile definitions and per-slot operator defaults.
MODEL_PROFILES_JSON=
MODEL_DEFAULT_BINDINGS_JSON=
# Local artifacts (CTranslate2 directory, full pyannote pipeline directory, GGUF file).
ASR_MODEL_ARTIFACT=./models/whisper-large-v3-turbo-ct2
DIARIZATION_MODEL_ARTIFACT=./models/pyannote-speaker-diarization-3.1
DATA_ROOT=./data
DATABASE_PATH=./data/app.db
MAX_UPLOAD_BYTES=524288000
PROCESSING_CONCURRENCY=1
# Optional Unicode TTF; defaults to Windows Arial or Linux DejaVu Sans.
PDF_FONT_PATH=
