# Copy values into the shell before starting. Use absolute paths.
DB_PATH=/absolute/path/meeting-data/meetings.sqlite
STORAGE_DIR=/absolute/path/meeting-data/files
HF_HOME=/absolute/path/models/hf
ASR_MODEL_PATH=/absolute/path/models/whisper-large-v3-turbo
PYANNOTE_DIARIZATION_MODEL=/absolute/path/models/speaker-diarization-community-1
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_HUB_DISABLE_TELEMETRY=1
PYANNOTE_METRICS_ENABLED=0
OLLAMA_NO_CLOUD=1
OLLAMA_NOPRUNE=1
