# Copy values into the shell before starting. Use absolute paths.
DB_PATH=/absolute/path/meeting-data/meetings.sqlite
STORAGE_DIR=/absolute/path/meeting-data/files
HF_HOME=/absolute/path/models/hf
ASR_MODEL_ARTIFACT=/absolute/path/models/whisper-large-v3-turbo-ct2
DIARIZATION_MODEL_ARTIFACT=/absolute/path/models/pyannote-speaker-diarization-3.1
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_HUB_DISABLE_TELEMETRY=1
PYANNOTE_METRICS_ENABLED=0
ASR_DEVICE=cpu
ASR_COMPUTE_TYPE=int8
DIARIZATION_DEVICE=cpu
MODEL_PATH=./Qwen3.5-4B-UD-Q6_K_XL.gguf
LLAMA_SERVER_PATH=llama-server
LLAMA_GPU_LAYERS=99
LLM_BASE_URL=http://127.0.0.1:27362/v1
LLM_MODEL=qwen3.5-4b-local
LLM_CONTEXT_SIZE=8192
LLM_MAX_OUTPUT_TOKENS=2048
LLM_TIMEOUT_SECONDS=120
